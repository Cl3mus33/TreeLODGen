<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- .NET 9 turns on hardware shadow stacks (CET) by default; Mod Organizer 2's virtual
         file system hooks crash a process started with them, before it reaches Main. -->
    <CETCompat>false</CETCompat>
    <Version>1.0.3</Version>
    <ApplicationIcon>TreeLODGen.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="niflysharp" Version="1.3.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
  </ItemGroup>

</Project>
